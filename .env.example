# Route generation through a real 3D model instead of the built-in engine.
# Leave both unset to use the procedural engine (no key, no network).
#
# SAGG3D_PROVIDER=meshy   # meshy | tripo
# SAGG3D_API_KEY=your-key-here
#
# Set these on a server deployment (Vercel, a container, `next start`). The
# workspace also accepts a key entered in the UI, which is kept in that
# browser only — use that when you cannot run a server.
